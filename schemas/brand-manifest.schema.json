{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nsq.global/schemas/brand-manifest.schema.json",
  "title": "NSQ Brand Context Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brand",
    "slug",
    "type",
    "status",
    "canonical",
    "domain",
    "context_version",
    "last_reviewed"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "brand": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "type": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "canonical": { "type": "boolean", "const": true },
    "domain": { "type": "string", "minLength": 1 },
    "context_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "last_reviewed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
