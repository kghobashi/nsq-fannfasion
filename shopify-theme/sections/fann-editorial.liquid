<section id="{{ section.settings.anchor | default: section.id | escape }}" class="fann-editorial" style="--fann-bg:{{ section.settings.background }};--fann-ink:{{ section.settings.text_color }};--fann-accent:{{ section.settings.accent }};--fann-space:{{ section.settings.spacing }}px">
  <div class="fann-editorial__inner">
    {% for block in section.blocks %}
      <div class="fann-editorial__block" {{ block.shopify_attributes }}>
        {% case block.type %}
          {% when 'heading' %}<h2>{{ block.settings.text | escape }}</h2>
          {% when 'text' %}<div class="fann-editorial__text">{{ block.settings.text }}</div>
          {% when 'button' %}{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="fann-editorial__button">{{ block.settings.label | escape }}<span aria-hidden="true"> →</span></a>{% endif %}
          {% when 'image' %}{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1600 | image_tag: widths: '400,800,1200,1600', sizes: '(max-width:749px) 100vw, 800px', loading: 'lazy', class: 'fann-editorial__image' }}{% endif %}
        {% endcase %}
      </div>
    {% endfor %}
  </div>
</section>
{% stylesheet %}
.fann-editorial{background:var(--fann-bg);color:var(--fann-ink);padding:var(--fann-space) 24px;scroll-margin-top:100px;border-block:1px solid #b29c7d30}.fann-editorial__inner{max-width:820px;margin:auto;text-align:center;display:grid;gap:26px}.fann-editorial h2{font-family:var(--font-heading--family);font-size:clamp(24px,2.6vw,38px);font-weight:var(--fann-display-weight,500);line-height:1.3;letter-spacing:.1em;text-transform:uppercase;margin:0;text-wrap:balance}.fann-editorial__text{font-size:16px;line-height:1.75;max-width:660px;margin:auto;color:#d0cdc6}.fann-editorial__text p{margin:0 0 16px}.fann-editorial__text p:last-child{margin:0}.fann-editorial__button{border:1px solid var(--fann-accent);color:var(--fann-accent);display:inline-flex;gap:24px;align-items:center;min-height:50px;padding:15px 26px;text-decoration:none;text-transform:uppercase;font-size:11px;letter-spacing:.16em}.fann-editorial__button:hover{background:var(--fann-accent);color:#111}.fann-editorial__button:focus-visible{outline:2px solid var(--fann-ink);outline-offset:5px}.fann-editorial__image{max-width:100%;height:auto}@media(max-width:749px){.fann-editorial{padding:56px 24px}.fann-editorial__text{font-size:15px}}
{% endstylesheet %}
{% schema %}
{"name":"FANN editorial","settings":[{"type":"text","id":"anchor","label":"Section anchor"},{"type":"range","id":"spacing","label":"Vertical spacing","min":24,"max":160,"step":4,"unit":"px","default":80},{"type":"color","id":"background","label":"Background","default":"#161719"},{"type":"color","id":"text_color","label":"Text","default":"#E8E6E0"},{"type":"color","id":"accent","label":"Accent","default":"#B29C7D"}],"blocks":[{"type":"heading","name":"Heading","settings":[{"type":"text","id":"text","label":"Heading","default":"Confidence begins underneath."}]},{"type":"text","name":"Text","settings":[{"type":"richtext","id":"text","label":"Text"}]},{"type":"button","name":"Button","settings":[{"type":"text","id":"label","label":"Label","default":"Discover FANN"},{"type":"url","id":"link","label":"Link"}]},{"type":"image","name":"Image","settings":[{"type":"image_picker","id":"image","label":"Image"}]}],"presets":[{"name":"FANN editorial","blocks":[{"type":"heading"},{"type":"text"}]}]}
{% endschema %}

