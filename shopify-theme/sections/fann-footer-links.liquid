<nav class="fann-footer-links" aria-label="{{ section.settings.label | escape }}">
  {% for block in section.blocks %}
    {% liquid
      assign destination = block.settings.url
      if block.type == 'page'
        assign destination = block.settings.page.url
      endif
    %}
    {% if destination != blank %}
      <a href="{{ destination }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
    {% endif %}
  {% endfor %}
</nav>
{% stylesheet %}
.fann-footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 28px;padding:24px;background:#161719;color:#e8e6e0;border-top:1px solid #b29c7d30}
.fann-footer-links a{display:inline-flex;align-items:center;min-height:44px;color:inherit;text-decoration:none;font-size:13px;line-height:1.5}
.fann-footer-links a:hover{text-decoration:underline;text-underline-offset:5px;color:#b29c7d}
.fann-footer-links a:focus-visible{outline:2px solid #b29c7d;outline-offset:4px}
{% endstylesheet %}
{% schema %}
{
  "name":"FANN footer navigation",
  "settings":[{"type":"text","id":"label","label":"Navigation label","default":"Footer navigation"}],
  "blocks":[
    {"type":"page","name":"Page link","settings":[{"type":"text","id":"label","label":"Label","default":"About FANN"},{"type":"page","id":"page","label":"Page"}]},
    {"type":"link","name":"Custom link","settings":[{"type":"text","id":"label","label":"Label","default":"Collections"},{"type":"url","id":"url","label":"Link"}]}
  ],
  "presets":[{"name":"FANN footer navigation"}]
}
{% endschema %}
