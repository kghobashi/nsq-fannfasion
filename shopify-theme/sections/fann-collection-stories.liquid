{% unless section.settings.only_empty_collection and collection.all_products_count > 0 %}
{% if section.settings.only_empty_collection and collection.all_products_count == 0 %}
  {% style %}#MainContent collection-component { display: none; }{% endstyle %}
{% endif %}
<section id="{{ section.settings.anchor | default: section.id | escape }}" class="fann-stories fann-stories--{{ section.settings.layout }}" style="--fann-bg:{{ section.settings.background }};--fann-ink:{{ section.settings.text_color }};--fann-accent:{{ section.settings.accent }};--fann-columns:{{ section.settings.columns }};--fann-space:{{ section.settings.spacing }}px">
  {% if section.settings.heading != blank %}<header class="fann-stories__header"><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}</header>{% endif %}
  <div class="fann-stories__grid">
    {% for block in section.blocks %}
      {% liquid
        assign card_image = block.settings.image | default: block.settings.collection.image
        assign card_title = block.settings.title | default: block.settings.collection.title
        assign card_link = block.settings.link
        if card_link == blank and section.settings.enable_links
          assign card_link = block.settings.collection.url
        endif
      %}
      <article class="fann-story" {{ block.shopify_attributes }}>
        <div class="fann-story__media">
          {% if card_image != blank %}{{ card_image | image_url: width: 1400 | image_tag: widths: '360,540,720,1000,1400', sizes: '(max-width:749px) 100vw, 50vw', loading: 'lazy', class: 'fann-story__image' }}{% endif %}
        </div>
        <div class="fann-story__copy"><h3>{{ card_title | escape }}</h3>{% if block.settings.text != blank %}<div class="fann-story__text">{{ block.settings.text }}</div>{% endif %}
          {% if card_link != blank %}<a class="fann-story__link" href="{{ card_link }}"><span>{{ block.settings.label | escape }}</span><span aria-hidden="true"> →</span></a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>
{% endunless %}
{% stylesheet %}
.fann-stories{background:var(--fann-bg);color:var(--fann-ink);padding-block:var(--fann-space);scroll-margin-top:110px}.fann-stories__header{padding:0 24px 36px;text-align:center;max-width:820px;margin:auto}.fann-stories__header h2{font-family:var(--font-heading--family);font-weight:var(--fann-display-weight,500);text-transform:uppercase;font-size:clamp(24px,2.45vw,36px);line-height:1.25;letter-spacing:.13em;margin:0 0 16px;text-wrap:balance}.fann-stories__header p{margin:0;font-size:16px;line-height:1.6;color:#c6c2ba}.fann-stories__grid{display:grid;grid-template-columns:repeat(var(--fann-columns),minmax(0,1fr));max-width:1600px;margin:auto;gap:1px;background:#b29c7d35;border-block:1px solid #b29c7d35}.fann-story{position:relative;background:var(--fann-bg);min-width:0}.fann-story__media{aspect-ratio:1;overflow:hidden;background:#202225}.fann-story__image{width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.fann-story:hover .fann-story__image{transform:scale(1.025)}.fann-story__copy{padding:24px 28px 28px}.fann-story h3{font-family:var(--font-heading--family);font-weight:var(--fann-display-weight,500);text-transform:uppercase;font-size:clamp(21px,2vw,28px);line-height:1.2;letter-spacing:.09em;margin:0 0 8px;color:inherit}.fann-story__text{max-width:430px;font-size:15px;line-height:1.55;color:#d0cdc6}.fann-story__text p{margin:0 0 8px}.fann-story__link{display:inline-flex;align-items:center;gap:22px;min-height:44px;color:var(--fann-accent);text-decoration:none;text-transform:uppercase;font-size:11px;letter-spacing:.18em}.fann-story__link:after{content:'';position:absolute;inset:0}.fann-story__link:focus-visible{outline:2px solid var(--fann-accent);outline-offset:4px}.fann-stories--feature .fann-story__media{aspect-ratio:1.15}.fann-stories--feature .fann-story__copy{position:absolute;bottom:0;left:0;right:0;padding:70px 36px 32px;background:linear-gradient(transparent,#101113f5)}.fann-stories--compact .fann-story__copy{padding:18px}.fann-stories--compact h3{font-size:18px;letter-spacing:.06em}.fann-stories--compact .fann-story__text{font-size:13px}
@media(max-width:749px){.fann-stories{padding-block:36px}.fann-stories__grid{grid-template-columns:1fr}.fann-stories__header{padding-bottom:24px}.fann-story__copy{padding:22px}.fann-stories--feature .fann-story__copy{padding:60px 24px 24px}.fann-stories--compact .fann-stories__grid{grid-template-columns:repeat(2,minmax(0,1fr))}.fann-stories--compact h3{font-size:16px}.fann-stories--compact .fann-story__copy{padding:16px 12px}}
@media(prefers-reduced-motion:reduce){.fann-story__image{transition:none}.fann-story:hover .fann-story__image{transform:none}}
{% endstylesheet %}
{% schema %}
{
  "name": "FANN collection stories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Section anchor"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "cards",
          "label": "Collection cards"
        },
        {
          "value": "feature",
          "label": "Editorial features"
        },
        {
          "value": "compact",
          "label": "Compact editions"
        }
      ],
      "default": "cards"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "enable_links",
      "label": "Link to selected collections",
      "default": false,
      "info": "Enable once collections are available on the storefront."
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#161719"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#E8E6E0"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#B29C7D"
    },
    {
      "type": "checkbox",
      "id": "only_empty_collection",
      "label": "Show only until collection products are published",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection or edition",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Link label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FANN collection stories"
    }
  ]
}
{% endschema %}
